{
  "name": "independent-browser-desktop-app",
  "version": "0.1.0-best-effort",
  "private": true,
  "type": "module",
  "description": "Unverified Gecko/WASM browser plugin. Not an iframe. Engine build required.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 tools/serve.py",
    "test:reference": "node --test --test-reporter=tap tests/reference/*.test.mjs",
    "test:owned-reference": "node --test --test-reporter=tap tests/legacy-owned/browser-source-launcher.test.mjs"
  }
}
