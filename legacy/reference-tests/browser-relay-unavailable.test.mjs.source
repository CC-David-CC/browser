import {test} from 'node:test';
import assert from 'node:assert/strict';
import {relayUnavailable} from '../active-system/assets/desktop/browser-relay-client.mjs';
test('upstream service outages offer a recovery action without mislabeling policy denials',()=>{
 for(const code of [502,503,504])assert.match(relayUnavailable(code),/temporarily unavailable.*Reset engine/);
 for(const code of [200,400,401,403,404,429])assert.equal(relayUnavailable(code),null);
});
