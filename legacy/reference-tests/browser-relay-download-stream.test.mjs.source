import {test} from 'node:test';
import assert from 'node:assert/strict';
import {readDownloadBody} from '../active-system/assets/desktop/browser-relay-client.mjs';
function response(chunks,length){return new Response(new ReadableStream({start(c){for(const x of chunks)c.enqueue(Uint8Array.from(x));c.close()}}),{headers:length===null?{}:{'content-length':length}})}
test('known-length chunks produce the exact bytes, including empty files',async()=>{
 assert.deepEqual([...await readDownloadBody(response([[1,2],[3,4,5]],'5'))],[1,2,3,4,5]);
 assert.deepEqual([...await readDownloadBody(response([],'0'))],[]);
});
test('missing Content-Length still works',async()=>assert.deepEqual([...await readDownloadBody(response([[1],[2]],null))],[1,2]));
test('rejects malformed, oversized, truncated, and overlong lengths',async()=>{
 await assert.rejects(readDownloadBody(response([],'-1')),/Invalid download length/);
 await assert.rejects(readDownloadBody(response([],'134217729')),/larger than 128 MiB/);
 await assert.rejects(readDownloadBody(response([[1]],'2')),/ended before/);
 await assert.rejects(readDownloadBody(response([[1,2]],'1')),/length does not match/);
});
test('cancels an in-progress stream when it exceeds its announced length',async()=>{
 let canceled=false;const body=new ReadableStream({pull(c){c.enqueue(Uint8Array.of(1,2));},cancel(){canceled=true}});
 await assert.rejects(readDownloadBody(new Response(body,{headers:{'content-length':'1'}})),/length does not match/);assert.equal(canceled,true);
});
test('accepts exactly 128 MiB arriving as chunks',async()=>{
 let count=0;const chunk=new Uint8Array(1024*1024).fill(0x5a);const body=new ReadableStream({pull(c){if(count++<128)c.enqueue(chunk);else c.close()}});
 const data=await readDownloadBody(new Response(body,{headers:{'content-length':String(128*1024*1024)}}));
 assert.equal(data.length,128*1024*1024);assert.equal(data[0],0x5a);assert.equal(data.at(-1),0x5a);
});
